<!--
  modules/types/pom.xml — Stage 2-f Task 1 module POM (Wave A)
  (docs/superpowers/plans/2026-07-20-stage2f-remaining-modules.md).

  STATUS: ADDITIVE and RUN BY HAND (mvn -pl modules/types -am package from
  the reactor root, or mvn -f modules/types/pom.xml package). Ant
  (modules/types/build.xml + build.incl.xml) remains the real build; nothing
  here is wired into CMake or any release build yet.

  WHY THIS MODULE. Part of Wave A — four modules with no unmigrated
  dependencies, verified from actual imports rather than from
  prebuildjava's topo-list position alone. types is the simplest of the
  four: exactly one reactor dependency and no third-party jar at all.

  STEP 1 FINDINGS (./maven-module-deps.sh types, 26 files):
    [1] imports (excluding own packages): java.io, java.nio, java.util,
        javax.swing.event (all JDK) and org.scilab.modules.localization —
        the one reactor dependency, below.
    [2] reflection targets: none.
    [3] fully-qualified uses with no import: org.scilab.modules.localization.
        Messages (already counted) and org.scilab.modules.javasci.Scilab —
        RULED OUT: confirmed by `grep -rn javasci modules/types/src/java`
        that every one of the 15 hits is a `@see org.scilab.modules.javasci.
        Scilab` javadoc tag (ScilabTList.java, ScilabDouble.java,
        ScilabIntegerReference.java, ScilabMList.java, ScilabList.java,
        GetScilabVariable.java, ScilabBooleanSparse.java, ScilabInteger.java,
        ScilabBoolean.java, ScilabDoubleReference.java,
        ScilabBooleanReference.java, GetScilabVariableJNI.java,
        ScilabString.java, ScilabPolynomial.java, ScilabSparse.java) — never
        an import or a real type reference. This is exactly the
        over-reporting the tool's own header comment warns about (the
        graphic_objects/org.scilab.modules.gui javadoc precedent), and it
        also matches the wave's own dependency direction: per the Wave B
        table, javasci depends on types (javasci<-types), not the reverse —
        a real compile-time edge here would be a reactor CYCLE, not merely
        premature.
  No manifest.class-path anywhere in build.xml (confirmed again in the
  Ant-built jar's manifest: Class-Path is the literal, never-interpolated
  string "${manifest.class-path}").
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.scilab</groupId>
    <artifactId>scilab-modules-parent</artifactId>
    <version>2027.0.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>types</artifactId>
  <packaging>jar</packaging>

  <!-- build.xml:19 <property name="library.title" value="Java compatible types"/> -->
  <name>Java compatible types</name>

  <dependencies>
    <!-- Messages.java-consuming classes import org.scilab.modules.
         localization.Messages — same reactor-sibling idiom as
         modules/commons/pom.xml's own localization dependency. -->
    <dependency>
      <groupId>org.scilab</groupId>
      <artifactId>localization</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>

  <build>
    <!-- build.incl.xml:22 <property name="src.dir" location="src/java/"/>.
         Same source tree Ant compiles — see modules/localization/pom.xml's
         identical comment; nothing module-specific to add here. -->
    <sourceDirectory>src/java</sourceDirectory>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <!-- addMavenDescriptor=false and the Built-By entry are
                 inherited from the parent POM — not redeclared here. Same
                 manifestFile mechanism as modules/localization/pom.xml (see
                 that file's build comment for the full rationale).
                 MANIFEST-section.MF's bytes were EXTRACTED from the actual
                 Ant-built jar's META-INF/MANIFEST.MF (unzip -p
                 modules/types/jar/org.scilab.modules.types.jar
                 META-INF/MANIFEST.MF), never retyped: Specification-Vendor
                 and Implementation-Vendor both carry the double-mangled
                 "Ã¨" (bytes c3 83 c2 a8) — see modules/localization/pom.xml's
                 fuller comment for the mechanism. Implementation-Version is
                 present, frozen at the literal "00000000 0000", positioned
                 between Implementation-Title and Implementation-Vendor
                 exactly where Ant places it. -->
            <manifestFile>${project.basedir}/src/main/manifest/MANIFEST-section.MF</manifestFile>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
