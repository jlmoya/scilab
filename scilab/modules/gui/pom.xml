  THE CLASS-PATH WRAP — the reason Task 3 exists. build.xml:9 sets
  manifest.class-path to the literal six-token string "flexdock.jar
  jrosetta-engine.jar jrosetta-API.jar javafx.base.jar javafx.swing.jar
  javafx.graphics.jar". Ant's own built jar (unzip -p modules/gui/jar/
  org.scilab.modules.gui.jar META-INF/MANIFEST.MF) wraps that value across
  two physical lines INSIDE the 72-byte-per-line manifest format, and the
  wrap lands mid-token:
      Class-Path: flexdock.jar jrosetta-engine.jar jrosetta-API.jar javafx.b
       ase.jar javafx.swing.jar javafx.graphics.jar
  measured directly: the first physical line is exactly 70 bytes including
  the trailing CRLF's two bytes' worth of reserved room (org.apache.tools.
  ant.taskdefs.Manifest's own wrap width), breaking "javafx.base.jar" into
  "javafx.b" + continuation "ase.jar". Maven's plexus-archiver, building
  from the identical logical value, wraps at the full 72 bytes instead —
  DIFFERENT byte columns, same logical value. No POM content changes this
  (both a pre-wrapped-at-70 and a single-logical-line value were fed to
  Maven during this campaign's earlier measurement and produced the
  identical 72-byte Maven-side break either way), so the fragment below
  extracts Ant's own bytes verbatim (wrap included) rather than inventing a
  different source form. parity/fingerprint.py's normalize_manifest joins
  continuation lines on BOTH sides before comparing, specifically so this
  measured, real, un-fixable difference compares equal instead of failing
  the gate — see that function, not this POM, for the mechanism. THE FULL
  BYTE COMPARISON (both sides, Ant's raw jar and this module's built jar)
  is recorded in the Stage 2-f Task 3 report, not restated here.

  IMPLEMENTATION-VERSION: present, frozen at the literal "00000000 0000",
  positioned between Implementation-Title and Implementation-Vendor exactly
  where Ant's own jar places it (Ant's live value there today is
  "20260719 1729" — a DSTAMP/TSTAMP pair, replaced with the frozen literal
  for the same reason and by the same mechanism as every other migrated
  module; see modules/localization/pom.xml's <build> comment for the full
  runtime-consumer rationale). Vendor string double-encoded ("Ã¨", bytes c3
  83 c2 a8) — extracted, never retyped, same as every other module.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.scilab</groupId>
    <artifactId>scilab-modules-parent</artifactId>
    <version>2027.0.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>gui</artifactId>
  <packaging>jar</packaging>

  <!-- build.xml:8 <property name="library.title" value="Graphical interface"/> -->
  <name>Graphical interface</name>

  <dependencies>
    <!-- org.scilab.modules.action_binding.{InterpreterManagement,
         highlevel.ScilabInterpreterManagement}. -->
    <dependency>
      <groupId>org.scilab</groupId>
      <artifactId>action_binding</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- org.scilab.modules.commons.{,gui,utils,xml}.* across the bridge/
         ged/utils packages — the widest reactor import after graphic_objects. -->
    <dependency>
      <groupId>org.scilab</groupId>
      <artifactId>commons</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- org.scilab.modules.console.{HelpBrowser, OneCharKeyEventListener,
         SciConsole, SciHistoryManager, SciInputCommandView, SciOutputView,
         utils.ScilabSpecialTextUtilities}. -->
    <dependency>
      <groupId>org.scilab</groupId>
      <artifactId>console</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- org.scilab.modules.graphic_export.{Driver, ExportParams,
         FileExporter} — the export-format bridge behind the GUI's Export menu. -->
    <dependency>
      <groupId>org.scilab</groupId>
      <artifactId>graphic_export</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- org.scilab.modules.graphic_objects.* — this module's single widest
         package family (arc, axes, console, datatip, figure,
         graphicController, graphicModel, graphicObject, graphicView,
         uicontrol{,.frame.border}, utils) plus the full
         GraphicObjectProperties.__GO_*__ static-import family used across
         the ged/ editor packages. -->
    <dependency>
      <groupId>org.scilab</groupId>
      <artifactId>graphic_objects</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- org.scilab.modules.history_manager.HistoryManagement. -->
    <dependency>
      <groupId>org.scilab</groupId>
      <artifactId>history_manager</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- org.scilab.modules.jvm.LoadClassPath. -->
    <dependency>
      <groupId>org.scilab</groupId>
      <artifactId>jvm</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- org.scilab.modules.localization.Messages — the ordinary
         reactor-sibling idiom used across nearly every module. -->
    <dependency>
      <groupId>org.scilab</groupId>
      <artifactId>localization</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- org.scilab.modules.renderer.{CallRenderer, JoGLView{,.axes,.util},
         utils{,.textRendering}.*} — the classic (non-Vulkan) plot renderer
         bridge. -->
    <dependency>
      <groupId>org.scilab</groupId>
      <artifactId>renderer</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- org.scilab.forge.scirenderer.{Canvas, implementation.{jogl,vulkan}.*,
         tranformations.Vector3d} — a REACTOR SIBLING despite the
         org.scilab.forge.* package namespace (see modules/graphic_objects/
         pom.xml's identical note). Carries BOTH canvas backends gui's
         bridge/canvas package selects between at runtime (ScilabCanvasFactory). -->
    <dependency>
      <groupId>org.scilab</groupId>
      <artifactId>scirenderer</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- FLEXDOCK — gui's dockable tab/window layer
         (org.flexdock.docking{,.activation,.defaults,.drag.{effects,preview},
         .event{,.hierarchy},.floating.frames,.props,.state},
         org.flexdock.perspective.persist.xml, org.flexdock.view). SAME
         MECHANISM, SAME COORDINATE AS modules/commons/pom.xml (cross-
         referenced, not restated — see that file's <dependencies> comment
         for the full systemPath-vs-alternatives rationale; its own text
         names gui by name as a future consumer). -->
    <dependency>
      <groupId>org.flexdock</groupId>
      <artifactId>flexdock</artifactId>
      <version>1.2.5</version>
    </dependency>
    <!-- THE TWO VENDORED ROSETTA JARS — com.artenum.rosetta.interfaces.ui.
         InputCommandView (jrosetta-API) and com.artenum.rosetta.util.
         StringConstants (jrosetta-engine), verified per-class (see this
         file's header comment). SAME MECHANISM, SAME TWO COORDINATES AS
         modules/console/pom.xml (cross-referenced, not restated). -->
    <dependency>
      <groupId>com.artenum.rosetta</groupId>
      <artifactId>jrosetta-API</artifactId>
      <version>1.0.4</version>
    </dependency>
    <dependency>
      <groupId>com.artenum.rosetta</groupId>
      <artifactId>jrosetta-engine</artifactId>
      <version>1.0.4</version>
    </dependency>
    <!-- THE JOGL / GLUEGEN PAIR — com.jogamp.opengl{,.awt} (GL,
         GLAutoDrawable, GLCapabilities, GLException, GLProfile, GLCanvas,
         GLJPanel), the classic JOGL figure canvas. SAME MECHANISM, SAME TWO
         REAL MAVEN CENTRAL COORDINATES AS modules/renderer/pom.xml and
         modules/scirenderer/pom.xml (cross-referenced, not restated — see
         this file's header comment, "THE JOGL / GLUEGEN PAIR"). -->
    <dependency>
      <groupId>org.jogamp.jogl</groupId>
      <artifactId>jogl-all</artifactId>
      <version>2.5.0</version>
    </dependency>
    <dependency>
      <groupId>org.jogamp.gluegen</groupId>
      <artifactId>gluegen-rt</artifactId>
      <version>2.5.0</version>
    </dependency>
    <!-- org.scilab.forge.jlatexmath.{TeXConstants, TeXFormula, TeXIcon} —
         label/GED text rendering. Same single plain jar (no jlatexmath-fop)
         as modules/console/pom.xml and modules/renderer/pom.xml — see this
         file's header comment. -->
    <dependency>
      <groupId>org.scilab.forge</groupId>
      <artifactId>jlatexmath</artifactId>
      <version>1.0.7</version>
    </dependency>
    <!-- GSON — com.google.gson.Gson (SwingScilabBrowser.java, the CEF
         bridge). Real Maven Central coordinate, sourced from
         fetch-thirdparty.sh's own MAVEN_MANIFEST (not invented); system
         scope means it is never actually resolved from a repository here
         either — see this file's header comment, "THE THREE-JAR CLASS-PATH
         TAIL". -->
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>2.10.1</version>
    </dependency>
    <!-- JCEF — org.cef.{CefApp, CefClient, CefSettings, browser.*,
         callback.*, handler.*, misc.*, network.*}, the embedded Chromium
         browser (help browser + plot browser bridge). Real Maven Central
         coordinate (me.friwi:jcef-api), sourced from fetch-thirdparty.sh's
         own MAVEN_MANIFEST — the exact CEF-146 pin recorded there fixes the
         CEF-135-on-macOS-26 crash. See this file's header comment. -->
    <dependency>
      <groupId>me.friwi</groupId>
      <artifactId>jcef-api</artifactId>
      <version>jcef-d3de827+cef-146.0.10+g8219561+chromium-146.0.7680.179</version>
    </dependency>
    <!-- JHALL (JavaHelp) — javax.help{,.event,.plaf.basic,.search}, the
         embedded help viewer. LABEL only (no confirmed Maven Central
         coordinate; ships from the "official Scilab prerequirements"
         tarball, same standing as jlatexmath below) — see this file's
         header comment, "THE THREE-JAR CLASS-PATH TAIL", including the
         maven-module-deps.sh javax.* classification caveat this dependency
         surfaced. -->
    <dependency>
      <groupId>javax.help</groupId>
      <artifactId>javahelp</artifactId>
      <version>2.0</version>
    </dependency>
    <!-- THE THREE manifest.class-path JAVAFX ENTRIES — javafx.{application,
         collections,embed.swing,stage{,.FileChooser}}, used by the
         JCEF/help-browser embedding and the native file chooser bridge.
         org.openjfx is JavaFX's real Maven Central group; fetch-thirdparty.sh
         installs these three specific jars (base/graphics/swing) straight
         from the official openjfx-25.0.2 osx-aarch64 SDK zip's lib/
         directory (JDK-25 parity, per that script's own comment) — version
         25.0.2 below reflects that exactly, though the SDK's plain
         (classifier-less) jars are used here rather than Central's
         platform-classified artifacts, same "accurate label, system scope
         never resolves it" standing as every other vendored jar in this
         file. -->
    <!-- JavaFX resolves from Maven Central with a PLATFORM CLASSIFIER. The unclassified
         org.openjfx artifact is a 4 KB stub carrying ZERO classes (verified: 0 .class entries in
         javafx-graphics-25.0.2.jar) — depending on it without the classifier compiles nothing.
         The mac-aarch64 classifier carries the real code, and its class set is IDENTICAL to the
         SDK jars this replaces: 662 / 3024 / 48 entries for base / graphics / swing, diffed
         name-by-name with zero differences.

         ${javafx.platform} is a parent property so a Windows/Linux port changes one line (or adds
         an OS-activated profile) rather than three dependencies. Today this fork is macOS/arm64
         only, so a single default is honest rather than limiting.

         NATIVES ARE NOT AFFECTED. The classifier jars embed 8 dylibs, but Scilab loads JavaFX
         natives from lib/thirdparty/ via java.library.path, which fetch-thirdparty.sh still fills
         from the sha256-pinned Gluon SDK. JavaFX's NativeLibLoader prefers java.library.path and
         only falls back to extracting from the jar, so the embedded copies stay inert. -->
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-base</artifactId>
      <version>25.0.2</version>
      <classifier>${javafx.platform}</classifier>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-swing</artifactId>
      <version>25.0.2</version>
      <classifier>${javafx.platform}</classifier>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-graphics</artifactId>
      <version>25.0.2</version>
      <classifier>${javafx.platform}</classifier>
    </dependency>
    <!-- cc.sosonline.gpu.{GpuSurfaceComponent, NativeSurface, VulkanScene}
         — the Vulkan canvas's Layer-1 GPU surface. FIRST-PARTY, not a
         genuine third party: tracked in this repo at
         firstparty/swing-gpu-surface-0.1.0.jar and copied to thirdparty/ by
         fetch-thirdparty.sh (its own comment calls this out explicitly).
         See this file's header comment, "THE cc.sosonline.gpu FINDING", for
         why the lwjgl/kotlin-stdlib/jna/slf4j-api/annotations/
         directory-watcher jars that jar's OWN build needed are not repeated
         here. -->
    <dependency>
      <groupId>cc.sosonline</groupId>
      <artifactId>swing-gpu-surface</artifactId>
      <version>0.1.0</version>
    </dependency>
  </dependencies>

  <build>
    <!-- build.incl.xml:22 <property name="src.dir" location="src/java/"/>.
         Same source tree Ant compiles — see modules/localization/pom.xml's
         identical comment; nothing module-specific to add here. -->
    <sourceDirectory>src/java</sourceDirectory>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <!-- addMavenDescriptor=false and the Built-By entry are
                 inherited from the parent POM — not redeclared here. Same
                 manifestFile mechanism as modules/localization/pom.xml (see
                 that file's build comment for the full rationale).
                 MANIFEST-section.MF's bytes were EXTRACTED from the actual
                 Ant-built jar's META-INF/MANIFEST.MF (unzip -p
                 modules/gui/jar/org.scilab.modules.gui.jar
                 META-INF/MANIFEST.MF), never retyped: Specification-Vendor
                 and Implementation-Vendor both carry the double-mangled
                 "Ã¨" (bytes c3 83 c2 a8) — see modules/localization/pom.xml's
                 fuller comment for the mechanism. Implementation-Version is
                 present, frozen at the literal "00000000 0000", positioned
                 between Implementation-Title and Implementation-Vendor
                 exactly where Ant places it. Class-Path carries gui's own
                 six-entry manifest.class-path value exactly as Ant wrapped
                 it (mid-token, at Ant's 70-byte column) — see this file's
                 header comment, "THE CLASS-PATH WRAP", for why the wrap
                 column itself does not matter and is not reproduced as a
                 goal in its own right. -->
            <manifestFile>${project.basedir}/src/main/manifest/MANIFEST-section.MF</manifestFile>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
