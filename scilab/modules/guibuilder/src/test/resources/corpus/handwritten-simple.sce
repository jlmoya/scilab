// -----------------------------------------------------------------------------
// Corpus fixture: HAND-WRITTEN for this test suite. Not copied from anywhere.
//
// It replaces an earlier fixture that was a verbatim copy of
// lsf_toolbox/macros/leastsqr.sci. That toolbox is licensed GPL-3.0 and Scilab
// is GPL v2.0 (not "or later"); the two are incompatible for redistribution,
// so the copy could not stay in this tree whatever its usefulness as a test.
//
// Shaped like the real thing rather than minimised, because a fixture that is
// easy to parse proves nothing: a function wrapper, a figure built over a
// dozen "..."-continued lines, frames used as parents, mixed-case property
// names, tab indentation, calls with and without a trailing semicolon, a
// two-dot continuation, string-matrix values that have to lock, uimenu calls
// this parser does not model, and dot-property assignments after the fact.
//
// CRLF line endings throughout: this is the corpus's only CRLF file, and
// .gitattributes in this directory exists to keep git from normalising it.
// -----------------------------------------------------------------------------


function signalpanel()
	// ============================ Main figure =================================
	f = figure("figure_position",[120,40],...
	"figure_size",[980,700],...
	"auto_resize","on",...
	"background",[33],...
	"figure_name","Signal Explorer",....
	"dockable","on",...
	"infobar_visible","off",...
	"toolbar_visible","off",...
	"menubar_visible","on",...
	"default_axes","off",....
	"visible","off",...
	"menubar","none");

	//////////
	handles.dummy = 0;
	IconPath = fullpath(SCI + "/modules/gui/images/icons/16x16/actions");
	// ================================ Menu ====================================

	// Toggle the grid on and off
	handles.menu_1 = uimenu(f,...
	"icon",IconPath+"/view-grid.png",...
	"callback","ToggleGrid(handles)",...
	"Enable","off",...
	"label","grid |");
	// Label the axes
	handles.menu_2 = uimenu(f,...
	"icon",IconPath+"/insert-text.png",...
	"callback","LabelAxes(handles)",...
	"Enable","off",...
	"label","labels |");

	handles.menu_3 = uimenu(f,...
	"icon",IconPath+"/view-legend.png",...
	"callback","ToggleLegend(handles)",...
	"Enable","off",...
	"label","legend |");

	// Help for this panel
	handles.menu_4 = uimenu(f,...
	"icon",IconPath+"/help-browser.png",...
	"callback","help",...
	"label","help |");
	// Print the figure
	handles.menu_5 = uimenu(f,...
	"icon",IconPath+"/document-print.png",...
	"callback","PrintPanel(handles)",...
	"label","print");

	// ============================= Frames =====================================

	handles.InputFrame = uicontrol(f,...
	"unit","normalized",...
	"BackgroundColor",[0.8,0.8,0.8],...
	"Position",[0,0,0.32,1],...
	"Relief","sunken",...
	"Style","frame");
	handles.OutputFrame = uicontrol(f,...
	"unit","normalized",...
	"BackgroundColor",[0.8,0.8,0.8],...
	"Position",[0.32,0.20,0.68,0.76],...
	"Relief","sunken",...
	"Style","frame");
	handles.StatusFrame = uicontrol(handles.InputFrame,...
	"unit","normalized",...
	"BackgroundColor",[0.8,0.8,0.8],...
	"Position",[0.01,0,0.98,0.29],...
	"Relief","sunken",...
	"Style","frame");

	handles.PickFrame = uicontrol(handles.InputFrame,...
	"unit","normalized",...
	"BackgroundColor",[0.8,0.8,0.8],...
	"Position",[0.01,0.51,0.98,0.13],...
	"Relief","sunken",...
	"Style","frame");

	handles.ActionFrame = uicontrol(handles.InputFrame,...
	"unit","normalized",...
	"BackgroundColor",[0.8,0.8,0.8],...
	"Position",[0.01,0.3,0.98,0.2],...
	"Relief","sunken",...
	"Style","frame");

	// ======================== Inside the input frame ==========================

	//                            ---- Samples ----
	handles.SourceTitle = uicontrol(handles.InputFrame,...
	"unit","normalized",...
	"BackgroundColor",[0.8,0.6,0.95],...
	"HorizontalAlignment","left",...
	"Position",[0.01,0.96,0.98,0.035],...
	"FontName","Tahoma",...
	"FontSize",[12],...
	"String","Enter the samples you want to summarise:",...
	"Style","text");
	handles.SourceTable = uicontrol(handles.InputFrame,...
	"unit","normalized",...
	"Position",[0.01,0.68,0.98,0.28],...
	"Relief","sunken",...
	"String","",...
	"Style","table");
	// Title of the pick frame
	handles.PickTitle = uicontrol(handles.InputFrame,...
	"unit","normalized",...
	"BackgroundColor",[0.8,0.6,0.95],...
	"FontName","Tahoma",...
	"FontSize",[12],...
	"HorizontalAlignment","left",...
	"Position",[0.01,0.64,0.98,0.039],...
	"String","Or pick a variable : ",...
	"Style","text")

	// ------------------------- Inside the pick frame --------------------------

	handles.UseWorkspace = uicontrol(handles.PickFrame,...
	"unit","normalized",...
	"BackgroundColor",[0.8,0.8,0.8],...
	"FontName","Tahoma",...
	"FontSize",[12],...
	"Position",[0.01,0.7,0.98,0.2],...
	"String","Take the data from the variable browser",...
	"Style","radiobutton",...
	"Callback","UseWorkspace_Callback(handles)");
	handles.XLabel = uicontrol(handles.PickFrame,...
	"unit","normalized",...
	"BackgroundColor",[0.8,0.8,0.8],...
	"FontName","Tahoma",...
	"FontSize",[12],...
	"Position",[0.02,0.4,0.2,0.2],...
	"String","X data :",...
	"Style","text");
	handles.XPick = uicontrol(handles.PickFrame,...
	"unit","normalized",...
	"Enable","off",...
	"FontName","Tahoma",...
	"FontSize",[12],...
	"Position",[0.24,0.4,0.55,0.2],...
	"String","",...
	"Style","popupmenu",...
	"value", 0, ...
	"Callback","XPick_Callback(handles)");
	handles.XCount = uicontrol(handles.PickFrame,...
	"unit","normalized",...
	"BackgroundColor",[0.8,0.8,0.8],...
	"FontName","Tahoma",...
	"FontSize",[12],...
	"Position",[0.8,0.4,0.19,0.2],...
	"String","",...
	"Style","text");
	handles.YLabel = uicontrol(handles.PickFrame,...
	"unit","normalized",...
	"BackgroundColor",[0.8,0.8,0.8],...
	"FontName","Tahoma",...
	"FontSize",[12],...
	"Position",[0.02,0.1,0.2,0.2],...
	"String","Y data :",...
	"Style","text");
	handles.YPick = uicontrol(handles.PickFrame,...
	"unit","normalized",...
	"BackgroundColor",[0.8,0.8,0.8],...
	"Enable","off",...
	"FontName","Tahoma",...
	"FontSize",[12],...
	"Position",[0.24,0.1,0.55,0.2],...
	"String","",...
	"Style","popupmenu",...
	"value", 0, ...
	"Callback","YPick_Callback(handles)");
	handles.YCount = uicontrol(handles.PickFrame,...
	"unit","normalized",...
	"BackgroundColor",[0.8,0.8,0.8],...
	"FontName","Tahoma",...
	"FontSize",[12],...
	"Position",[0.8,0.1,0.19,0.2],...
	"String","",...
	"Style","text");

	// ------------------------ Inside the action frame -------------------------

	handles.MethodPick = uicontrol(handles.ActionFrame,...
	"unit","normalized",...
	"BackgroundColor",[0.1,0.4,0.1],...
	"Enable","on",...
	"FontName","Tahoma",...
	"FontSize",[12],...
	"Position",[0.02,0.75,0.96,0.2],...
	"string",["Mean","Median","Trimmed mean","Winsorised mean","Moving average","Envelope"],...
	"value",1,...
	"Style","popupmenu",...
	"Callback","MethodPick_Callback(handles)");
	handles.WindowLabel = uicontrol(handles.ActionFrame,...
	"unit","normalized",...
	"BackgroundColor",[0.8,0.8,0.8],...
	"FontName","Tahoma",...
	"FontSize",[12],...
	"Position",[0.02,0.50,0.4,0.2],...
	"String","Window length :",...
	"Style","text",...
	"visible","off");
	handles.WindowEntry = uicontrol(handles.ActionFrame,...
	"unit","normalized",...
	"FontName","Tahoma",...
	"FontSize",[12],...
	"Position",[0.41,0.50,0.57,0.2],...
	"HorizontalAlignment","center",...
	"Relief","sunken",...
	"String","8",...
	"Style","edit",...
	"Callback","MethodPick_Callback(handles)",...
	"visible","off");
	handles.TaperLabel = uicontrol(handles.ActionFrame,...
	"unit","normalized",...
	"BackgroundColor",[0.8,0.8,0.8],...
	"FontName","Tahoma",...
	"FontSize",[12],...
	"Position",[0.02,0.50,0.2,0.2],...
	"String","Taper :",...
	"Style","text",...
	"visible","off");
	handles.TaperPick = uicontrol(handles.ActionFrame,...
	"unit","normalized",...
	"BackgroundColor",[0.8,0.8,0.8],...
	"Enable","on",...
	"FontName","Tahoma",...
	"FontSize",[12],...
	"Position",[0.21,0.50,0.77,0.2],...
	"string",["Rectangular","Hann","Hamming"],...
	"value",1,...
	"Style","popupmenu",...
	"Callback","TaperPick_Callback(handles)",...
	"visible","off");
	handles.ResetButton = uicontrol(handles.ActionFrame,...
	"unit","normalized",...
	"BackgroundColor",[0.9,0.5,0.4],...
	"FontName","Tahoma",...
	"FontSize",[12],...
	"Position",[0.06,0.05,0.3,0.2],...
	"Relief","raised",...
	"String","Reset results",...
	"Style","pushbutton",...
	"Callback","ResetResults(handles)");
	handles.RunButton = uicontrol(handles.ActionFrame,...
	"unit","normalized",...
	"BackgroundColor",[0.7,0.8,0.4],...
	"FontName","Tahoma",...
	"FontSize",[12],...
	"Position",[0.71,0.05,0.25,0.2],...
	"Relief","raised",...
	"String","Run",...
	"Style","pushbutton",...
	"Callback","MethodPick_Callback(handles)");
	handles.ClearButton = uicontrol(handles.ActionFrame,...
	"unit","normalized",...
	"BackgroundColor",[0.9,0.3,0.1],...
	"FontName","Tahoma",...
	"FontSize",[12],...
	"Position",[0.41,0.05,0.25,0.2],...
	"Relief","raised",...
	"String","Clear data",...
	"Style","pushbutton",...
	"Callback","ClearData(handles)");

	// ======================= Inside the output frame ==========================

	handles.PlotTitle = uicontrol(f,...
	"unit","normalized",...
	"BackgroundColor",[0.8,0.6,0.95],...
	"FontName","Tahoma",...
	"FontSize",[12],...
	"HorizontalAlignment","left",...
	"Position",[0.321,0.962,0.678,0.035],...
	"String"," Plot : ",...
	"Style","text")
	// Axes
	handles.Plot = newaxes(handles.OutputFrame);...
	handles.Plot.auto_clear = "on";

	//                        ---- Table of summaries ----
	handles.SummaryTitle = uicontrol(f,...
	"unit","normalized",...
	"BackgroundColor",[0.8,0.6,0.95],...
	"HorizontalAlignment","left",...
	"Position",[0.321,0.15,0.678,0.05],...
	"FontName","Tahoma",...
	"FontSize",[12],...
	"String","Table of summaries:",...
	"Style","text");
	handles.SummaryTable = uicontrol(f,...
	"unit","normalized",...
	"Position",[0.321,0.01,0.678,0.15],...
	"Relief","sunken",...
	"String","",...
	"Style","table");
	handles.SummaryTable.string = [["","Series","Method","N","Mean", "Median", "Std", "IQR", "# NaN"]; ["1","","","","","","", "",""]]
	// ======================= Inside the status frame ==========================
	handles.ResultTitle = uicontrol(handles.StatusFrame,...
	"unit","normalized",...
	"BackgroundColor",[0.8,0.6,0.95],...
	"FontName","Tahoma",...
	"FontSize",[12],...
	"HorizontalAlignment","left",...
	"Position",[0.01,0.88,0.99,0.12],...
	"String","Results : ",...
	"Style","text")
	handles.ResultTitle.Userdata = [];
	handles.LogText = uicontrol(handles.StatusFrame,...
	"unit","normalized",...
	"BackgroundColor",[1,1,1],...
	"ForegroundColor",[-1,-1,-1],..
	"FontName","Tahoma",...
	"FontSize",[12],...
	"FontWeight","normal",...
	"Max",[2],...
	"Position",[0,0.005,1,0.87],...
	"HorizontalAlignment","left",...
	"VerticalAlignment","top",...
	"Enable","on",...
	"String"," ",...
	"Userdata"," ",...
	"scrollable","on",...
	"Relief", "sunken",...
	"Margins",[50,50,50,50], ...
	"Style","edit");
	f.visible = 'on'
	[f,handles] = resume(f,handles);
	ClearData(handles);
endfunction
