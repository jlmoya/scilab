<!--
  modules/jvm/pom.xml — Stage 2-e Task 1 module POM
  (docs/superpowers/plans/2026-07-20-stage2e-topo-batch.md).

  STATUS: ADDITIVE and RUN BY HAND (mvn -pl modules/jvm -am package from the
  reactor root, or mvn -f modules/jvm/pom.xml package). Ant
  (modules/jvm/build.xml + build.incl.xml) remains the real build; nothing
  here is wired into CMake or any release build yet.

  WHY THIS MODULE MATTERS. Fifth in prebuildjava's topo order, and the one
  genuinely open question in this task: modules/jvm/src/java/org/scilab/
  modules/jvm/LibraryPath.java imports jdk.internal.loader.NativeLibraries
  and sun.misc.Unsafe, and reflectively rewrites LibraryPaths.USER_PATHS. It
  does not compile under JDK 17+ module encapsulation without the
  add-exports=java.base/jdk.internal.loader=ALL-UNNAMED compiler flag plus
  the two add-opens flags already declared at the parent POM
  (scilab/pom.xml, maven-compiler-plugin compilerArgs) — present since
  Stage 2-a's beachhead, because Ant applies them to every module's compile
  unconditionally (build.incl.xml:141-143), but never yet EXERCISED by a
  module that actually needs them. This module is that exercise; see the
  Stage 2-e Task 1 report for whether it compiled clean.

  STEP 1 FINDINGS (grep -rhE '^import (org|com|jdk|sun)\.'
  modules/jvm/src/java, 4 files):
    - jdk.internal.loader.NativeLibraries — LibraryPath.java: JDK-internal,
      resolved via the parent's compiler flags above, not a Maven
      dependency element.
    - sun.misc.Unsafe — LibraryPath.java: JDK-internal (still exported
      unconditionally on this JDK), likewise not a dependency element.
    - org.w3c.dom.{Document,Node,NodeList}, org.xml.sax.SAXException — JDK
      (java.xml module), not a dependency.
  No org.scilab.modules.* import anywhere — jvm is a leaf like localization
  and scirenderer, hence no dependencies block below. No manifest.class-path
  anywhere in build.xml (confirmed again in the Ant-built jar's manifest:
  Class-Path is the literal, never-interpolated string
  "${manifest.class-path}").
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.scilab</groupId>
    <artifactId>scilab-modules-parent</artifactId>
    <version>2027.0.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>jvm</artifactId>
  <packaging>jar</packaging>

  <!-- build.xml:19 <property name="library.title" value="JVM helpers"/> -->
  <name>JVM helpers</name>

  <build>
    <!-- build.incl.xml:22 <property name="src.dir" location="src/java/"/>.
         Same source tree Ant compiles — see modules/localization/pom.xml's
         identical comment; nothing module-specific to add here. -->
    <sourceDirectory>src/java</sourceDirectory>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <!-- addMavenDescriptor=false and the Built-By entry are
                 inherited from the parent POM — not redeclared here. Same
                 manifestFile mechanism as modules/localization/pom.xml (see
                 that file's build comment for the full rationale).
                 MANIFEST-section.MF's bytes were EXTRACTED from the actual
                 Ant-built jar's META-INF/MANIFEST.MF (unzip -p
                 modules/jvm/jar/org.scilab.modules.jvm.jar
                 META-INF/MANIFEST.MF), never retyped: Specification-Vendor
                 and Implementation-Vendor both carried (now un-mangled to "è" by register P1) the double-mangled
                 "Ã¨" (bytes c3 83 c2 a8) — see modules/localization/pom.xml's
                 fuller comment for the mechanism. Implementation-Version is
                 present, frozen at the literal "00000000 0000", positioned
                 between Implementation-Title and Implementation-Vendor
                 exactly where Ant places it. -->
            <manifestFile>${project.basedir}/src/main/manifest/MANIFEST-section.MF</manifestFile>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
