/* machine.h — GENERATED BY CMAKE (retire-configure RC-a).
   The CMake-computed counterpart of configure's modules/core/includes/machine.h.
   NOT byte-identical to autoconf's output by design; equivalence is proven
   SEMANTICALLY (the #define set) by the parity harness's header_defines dimension.
   One line per macro in modules/core/includes/machine.h.in (184 total slots).
   As of Task 3, cmake/ScilabMachineHeader.cmake probes/sets all 148 of those
   that the reference machine.h actually DEFINES on this dev tree's own
   configure run; the remaining 36 (HAVE_MACH_O_DYLD_H, ENABLE_MPI, WITH_TK,
   RAPIDJSON_MASTER, ...) are LEGITIMATELY left unset here too, because the
   reference itself leaves them undef (options this task doesn't own, or
   platform facts that are false on this host) — not because a later stage
   hasn't reached them. See that file's own header comment for the full
   per-bucket breakdown. */
/* The include guard MUST be spelled MACHINE_H — it matches configure's header
   (modules/core/includes/machine.h:4-5) and the harness parses it as a real macro
   (`MACHINE_H` -> ""), so any other spelling is a spurious macro diff. */
#ifndef MACHINE_H
#define MACHINE_H
/* This file defines global element configuration of the build host */


/* Define C2F without Trailing Underscore */
#define C2F(name) @C2F_BODY@

/* Define to 1 if the 'closedir' function returns void instead of int. */
#cmakedefine CLOSEDIR_VOID 1

/* Cname */
#define CNAME(name1,name2) @CNAME_BODY@

/* CURL flags */
/* Plain #define, not #cmakedefine -- same trap as PACKAGE_URL below, a
   different trigger: m4/curl.m4's AC_DEFINE_UNQUOTED(CURL_CFLAGS,
   ["$CURL_CFLAGS"], ...) (curl.m4:98) fires UNCONDITIONALLY right after
   AC_CHECK_LIB/AC_CHECK_HEADERS succeed -- curl is mandatory in Scilab
   (configure AC_MSG_ERRORs out otherwise), so any machine.h that exists at
   all has this defined. `curl-config --cflags` legitimately prints an empty
   line when curl's headers already sit on the default include path (common
   with a system-wide curl-dev install); #cmakedefine would wrongly read
   that empty CMake string as false and comment the macro out as undefined,
   instead of defined-to-empty-string like configure always does. */
#define CURL_CFLAGS "@CURL_CFLAGS@"

/* CURL library */
/* Plain #define: same unconditional-AC_DEFINE_UNQUOTED reasoning as
   CURL_CFLAGS just above (curl.m4:99). */
#define CURL_LIBS "@CURL_LIBS@"

/* CURL version */
/* Plain #define: same unconditional-AC_DEFINE_UNQUOTED reasoning as
   CURL_CFLAGS above (curl.m4:100). */
#define CURL_VERSION "@CURL_VERSION@"

