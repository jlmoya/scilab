/* Name of package */
#cmakedefine PACKAGE "@PACKAGE@"

/* Define to the address where bug reports for this package should be sent. */
#cmakedefine PACKAGE_BUGREPORT "@PACKAGE_BUGREPORT@"

/* Define to the full name of this package. */
#cmakedefine PACKAGE_NAME "@PACKAGE_NAME@"

/* Define to the full name and version of this package. */
#cmakedefine PACKAGE_STRING "@PACKAGE_STRING@"

/* Define to the one symbol short name of this package. */
#cmakedefine PACKAGE_TARNAME "@PACKAGE_TARNAME@"

/* Define to the home page for this package. */
/* Plain #define, not #cmakedefine: configure always defines this macro
   (AC_INIT's optional 5th arg is just an empty string when omitted, as it
   is here). CMake's #cmakedefine treats an empty-STRING variable as false,
   which would wrongly comment this macro out as undefined instead of
   emitting it defined-to-empty-string, as configure itself always does. */
#define PACKAGE_URL "@PACKAGE_URL@"

/* Define to the version of this package. */
#cmakedefine PACKAGE_VERSION "@PACKAGE_VERSION@"

/* The default path separator character. */
#cmakedefine PATH_SEPARATOR "@PATH_SEPARATOR@"

/* Using rapidjson master branch */
#cmakedefine RAPIDJSON_MASTER 1

/* Extension of a shared library */
#cmakedefine SHARED_LIB_EXT "@SHARED_LIB_EXT@"

/* Extension of a shared library ( wide string ) */
#cmakedefine SHARED_LIB_EXTW L"@SHARED_LIB_EXT@"

