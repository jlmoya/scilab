<?xml version="1.0" encoding="UTF-8"?>
<!--
  modules/action_binding/pom.xml — Stage 2-e Task 1 module POM
  (docs/superpowers/plans/2026-07-20-stage2e-topo-batch.md).

  STATUS: ADDITIVE and RUN BY HAND (mvn -pl modules/action_binding -am
  package from the reactor root, or mvn -f modules/action_binding/pom.xml
  package). Ant (modules/action_binding/build.xml + build.incl.xml) remains
  the real build; nothing here is wired into CMake or any release build yet.

  WHY THIS MODULE. Sixth in prebuildjava's topo order, right after jvm — and
  the first module in this task with TWO reactor dependencies at once.

  STEP 1 FINDINGS (grep -rhE '^import (org|com|jdk|sun)\.'
  modules/action_binding/src/java, 6 files):
    - org.scilab.modules.action_binding.* — itself (2 in-package imports:
      InterpreterManagement, utils.ActionBindingMessages, utils.Signal).
    - org.scilab.modules.commons.filemonitor.FileSystemMonitor —
      LibraryReloader.java: reactor dependency #1, below.
    - org.scilab.modules.localization.Messages — ActionBindingMessages.java:
      reactor dependency #2, below.
  No manifest.class-path anywhere in build.xml (confirmed again in the
  Ant-built jar's manifest: Class-Path is the literal, never-interpolated
  string "${manifest.class-path}").
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.scilab</groupId>
    <artifactId>scilab-modules-parent</artifactId>
    <version>2027.0.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>action_binding</artifactId>
  <packaging>jar</packaging>

  <!-- build.xml:21 <property name="library.title" value="Java-Scilab communication"/> -->
  <name>Java-Scilab communication</name>

  <dependencies>
    <!-- LibraryReloader.java imports
         org.scilab.modules.commons.filemonitor.FileSystemMonitor — same
         reactor-sibling idiom as modules/history_manager/pom.xml's commons
         dependency. -->
    <dependency>
      <groupId>org.scilab</groupId>
      <artifactId>commons</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- ActionBindingMessages.java imports
         org.scilab.modules.localization.Messages — same reactor-sibling
         idiom as modules/commons/pom.xml's localization dependency. -->
    <dependency>
      <groupId>org.scilab</groupId>
      <artifactId>localization</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>

  <build>
    <!-- build.incl.xml:22 <property name="src.dir" location="src/java/"/>.
         Same source tree Ant compiles — see modules/localization/pom.xml's
         identical comment; nothing module-specific to add here. -->
    <sourceDirectory>src/java</sourceDirectory>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <!-- addMavenDescriptor=false and the Built-By entry are
                 inherited from the parent POM — not redeclared here. Same
                 manifestFile mechanism as modules/localization/pom.xml (see
                 that file's build comment for the full rationale).
                 MANIFEST-section.MF's bytes were EXTRACTED from the actual
                 Ant-built jar's META-INF/MANIFEST.MF (unzip -p
                 modules/action_binding/jar/org.scilab.modules.action_binding.jar
                 META-INF/MANIFEST.MF), never retyped: Specification-Vendor
                 and Implementation-Vendor both carried (now un-mangled to "è" by register P1) the double-mangled
                 "Ã¨" (bytes c3 83 c2 a8) — see modules/localization/pom.xml's
                 fuller comment for the mechanism. Implementation-Version is
                 present, frozen at the literal "00000000 0000", positioned
                 between Implementation-Title and Implementation-Vendor
                 exactly where Ant places it. -->
            <manifestFile>${project.basedir}/src/main/manifest/MANIFEST-section.MF</manifestFile>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
