/* LIBARCHIVE flags */
/* Plain #define, not #cmakedefine -- same trap as CURL_CFLAGS/PACKAGE_URL
   elsewhere in this file: m4/libarchive.m4's AC_DEFINE_UNQUOTED(
   LIBARCHIVE_CFLAGS, ["$LIBARCHIVE_CFLAGS"], ...) (libarchive.m4:71) fires
   UNCONDITIONALLY -- libarchive is mandatory in Scilab, so any machine.h
   that exists at all has this defined, even in a hypothetical run where the
   captured $CFLAGS accumulator (see the transcription note in
   ScilabMachineHeader.cmake) held nothing libarchive-specific. #cmakedefine
   would wrongly comment this macro out as undefined instead of
   defined-to-empty-string. (The VALUE on this line is a transcription, not
   a CMake-computed probe -- see ScilabMachineHeader.cmake's bucket-2
   comment; this #define-vs-#cmakedefine fix is orthogonal to that and
   applies regardless of how the value itself is obtained.) */
#define LIBARCHIVE_CFLAGS "@LIBARCHIVE_CFLAGS@"

/* LIBARCHIVE library */
/* Plain #define: same reasoning as LIBARCHIVE_CFLAGS just above
   (libarchive.m4:72). */
#define LIBARCHIVE_LIBS "@LIBARCHIVE_LIBS@"

/* LIBARCHIVE version */
/* Plain #define: same reasoning as LIBARCHIVE_CFLAGS above
   (libarchive.m4:73). Unlike its two siblings, this VALUE is a real
   CMake-computed probe (see ScilabMachineHeader.cmake); only the
   #cmakedefine -> #define fix is shared. */
#define LIBARCHIVE_VERSION "@LIBARCHIVE_VERSION@"

/* libXML2 flags */
/* Plain #define, not #cmakedefine -- same trap as CURL_CFLAGS/PACKAGE_URL
   elsewhere in this file: m4/libxml2.m4's AC_DEFINE_UNQUOTED(LIBXML_FLAGS,
   ["$XML_FLAGS"], ...) (libxml2.m4:80) fires UNCONDITIONALLY once
   AC_CHECK_LIB succeeds -- libxml2 is mandatory in Scilab, so any machine.h
   that exists at all has this defined. `xml2-config --cflags` legitimately
   prints an empty line when libxml2's headers already sit on the default
   include path; #cmakedefine would wrongly read that empty CMake string as
   false and comment the macro out as undefined instead of
   defined-to-empty-string like configure always does. */
#define LIBXML_FLAGS "@LIBXML_FLAGS@"

/* libXML2 library */
/* Plain #define: same unconditional-AC_DEFINE_UNQUOTED reasoning as
   LIBXML_FLAGS just above (libxml2.m4:81). */
#define LIBXML_LIBS "@LIBXML_LIBS@"

/* Define to 1 if 'lstat' dereferences a symlink specified with a trailing
