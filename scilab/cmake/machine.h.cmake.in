#cmakedefine ENABLE_NLS 1

/* Define to 1 if the package shall run at any location in the filesystem. */
#cmakedefine ENABLE_RELOCATABLE 1

/* Define C2F without Trailing Underscore */
#define F2C(name) @F2C_BODY@

