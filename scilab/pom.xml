<?xml version="1.0" encoding="UTF-8"?>
<!--
  scilab/pom.xml — Stage 2-a "Maven beachhead" (build-cmake-maven-migration.md).

  STATUS: ADDITIVE and RUN BY HAND. Ant (build.incl.xml + each module's
  build.xml) remains the real, only build for every one of Scilab's 24 Java
  jars — nothing here is wired into CMake or any release build yet. This
  parent POM exists to answer one cheap question before the full migration
  (a hand-encoded module order, a four-way dependency tangle, ~78 vendored
  jars mostly lacking Maven coordinates): do the Maven mechanics and the
  existing build-parity "jars" dimension actually work on one real module?

  The one module currently wired up is modules/localization — see its own
  pom.xml for why it was chosen (a genuine leaf: 6 Java files, zero import
  statements) over modules/commons (imports org.scilab.modules.localization,
  so not a leaf). Record: .superpowers/sdd/task-2-brief.md,
  .superpowers/sdd/task-2-report.md.

  Everything under <build><plugins> here is POLICY shared by every Ant-built
  module jar (build.incl.xml's `compile`/`jar` targets, imported by every
  module's build.xml) — it belongs at the parent so each child module POM
  only has to add what is genuinely module-specific (its manifest section,
  its dependencies, if any).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.scilab</groupId>
  <artifactId>scilab-modules-parent</artifactId>
  <version>2027.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Scilab Java modules (Maven beachhead)</name>

  <modules>
    <module>modules/localization</module>
    <module>modules/commons</module>
    <module>modules/history_manager</module>
    <module>modules/jvm</module>
    <module>modules/action_binding</module>
    <module>modules/scirenderer</module>
    <module>modules/graphic_objects</module>
    <module>modules/completion</module>
    <module>modules/console</module>
    <module>modules/helptools</module>
    <module>modules/types</module>
    <module>modules/external_objects_java</module>
    <module>modules/renderer</module>
    <module>modules/javasci</module>
    <module>modules/graphic_export</module>
    <module>modules/gui</module>
    <module>modules/core</module>
    <module>modules/history_browser</module>
    <module>modules/graph</module>
    <module>modules/ui_data</module>
    <module>modules/scinotes</module>
    <module>modules/preferences</module>
    <module>modules/xcos</module>
    <module>modules/terminal</module>
  </modules>

  <properties>
    <!-- build.incl.xml:129 javac encoding="utf-8" -->
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- JavaFX platform classifier. The unclassified org.openjfx artifacts carry no classes at
         all, so every JavaFX dependency must name a platform. This fork targets macOS/arm64;
         a Windows/Linux port overrides this property (or adds an os-activated profile). -->
    <javafx.platform>mac-aarch64</javafx.platform>

    <!-- Java test stack — latest releases (JUnit 6 needs Java 17+; we build/run at 25).
         In JUnit 6 the platform is version-aligned with jupiter (both 6.x), so one
         property drives junit-jupiter AND junit-platform-launcher. -->
    <junit.version>6.1.2</junit.version>
    <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
    <jacoco-maven-plugin.version>0.8.15</jacoco-maven-plugin.version>
    <!-- Native test harness: build-test-native-libs.sh populates this symlink farm with
         every built module dylib, so surefire can load libscilab + its transitive
         (absolute-install-name) siblings for the native/integration Java tests. -->
    <scilab.test.native.libs>${session.executionRootDirectory}/build-cmake/test-native-libs</scilab.test.native.libs>
    <scilab.test.sci.root>${session.executionRootDirectory}</scilab.test.sci.root>
  </properties>

  <!-- Inherited test stack: every reactor module gets JUnit 6 (Jupiter) in test scope,
       plus the platform launcher surefire runs it through. Test scope, so nothing lands
       in any module jar (jar-content parity is unaffected). -->
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- Stage 2-c Decision A (design doc §3): reproduce Ant's jar NAME, not Maven's default
         (artifactId-version.jar, e.g. commons-2027.0.0-SNAPSHOT.jar). ${project.artifactId}
         resolves per-module and already equals the module directory name, which already
         equals Ant's jar infix — one line at the parent covers every module ever added,
         including the 22 not yet migrated. That equality is a CONVENTION, not something this
         POM enforces — but it does not need to be trusted, only checked: build-parity's capture
         keys maven_jars by directory (modules/<dir>/jar/<basename>), so a future POM whose
         artifactId diverges from its module directory produces an orphan key and fails the
         parity gate red (test_maven_jars_align_with_ant_jars) instead of silently mis-tagging.

         WHY THIS IS NOT COSMETIC. etc/classpath.xml hardcodes 23 module jars by full path AND
         name ($SCILAB/modules/<m>/jar/org.scilab.modules.<m>.jar); etc/jvm_options.xml:20
         hardcodes the JVM bootstrap entry the same way
         (-Djava.class.path=$SCILAB/modules/jvm/jar/org.scilab.modules.jvm.jar). Both are read
         by the RUNNING application. Renaming the jars would mean rewriting classpath.xml and
         jvm_options.xml — that is *improving*, and this campaign's binding principle is
         reproduce, don't improve (CMake/Maven must produce the same app autotools/Ant did,
         warts included). A build-tool swap must not, as a side effect, rewrite the running
         application's classpath.

         THE OUTPUT DIRECTORY IS DELIBERATELY NOT PART OF THIS CHANGE. Maven keeps writing to
         target/, not modules/<m>/jar/, for as long as Ant and Maven coexist. Pointing Maven at
         jar/ now would have both toolchains writing the SAME file — a stray `mvn package` run
         could then silently feed CMake (or a developer's Ant-built tree) a Maven jar under a
         path CMake believes only Ant ever writes, with no way to tell them apart after the
         fact. The directory only flips at the eventual CMake/Ant swap, when Ant stops writing
         there at all. Same basename in two different directories is also exactly what lets
         build-parity's maven_jars section key itself at Ant's modules/<m>/jar/<basename> path
         (parity/capture.py) and compare directly against `jars` — see
         build-parity/tests/test_acceptance.py::test_maven_jars_align_with_ant_jars.

         EXCEPTION, NOW HANDLED: scirenderer's jar does NOT follow the org.scilab.modules.*
         convention (it was one of the tracked orphans noted here until Stage 2-d Task 1
         migrated it). Its own POM, modules/scirenderer/pom.xml, overrides <finalName> to
         shadow this parent default — see that file's <build> comment for the full rationale
         (scilab-lib.properties:88's library.scirenderer.name, and etc/classpath.xml:127's
         hardcoded runtime path). -->
    <finalName>org.scilab.modules.${project.artifactId}</finalName>

    <!-- DEPENDENCY-UPDATE VISIBILITY, inherited by all 24 modules.

         versions-maven-plugin is declared here (pluginManagement, not <plugins>) because it
         binds to no lifecycle phase — it is invoked from the command line and never runs
         during `mvn package`. Declaring it centrally gives every module the same pinned
         version and the same ruleset, so the reports are comparable across the reactor:

           mvn versions:display-dependency-updates   # newer versions of what we depend on
           mvn versions:display-plugin-updates       # newer Maven plugins
           mvn versions:display-property-updates     # newer values for version properties

         IMPORTANT LIMITATION, so nobody expects more than this gives: 85 of this reactor's
         dependency entries are <scope>system</scope> with a <systemPath> into thirdparty/.
         The plugin can still REPORT newer versions for those coordinates, but it cannot
         apply them — versions:use-latest-versions rewrites a <version> element, while a
         vendored jar upgrade means replacing the file in thirdparty/, updating
         fetch-thirdparty.sh's pinned payload, AND bumping both <version> and the version
         embedded in <systemPath>. Treat this plugin as the detector, not the fixer.

         The ruleset suppresses pre-release and vendor-rebuild versions, which are noise
         here rather than upgrades: the first audit surfaced javafx 25.0.2 -> 27-ea+25 and
         maven-archiver 3.6.4 -> 4.0.0-beta-1, neither of which we would ship. Patterns must
         match the WHOLE version string (the plugin uses Matcher.matches()). -->
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>versions-maven-plugin</artifactId>
          <version>2.21.0</version>
          <configuration>
            <ruleSet>
              <ignoreVersions>
                <ignoreVersion>
                  <type>regex</type>
                  <version>(?i).*[-.](ea|alpha|beta|rc|cr|preview|snapshot)[-.0-9+]*</version>
                </ignoreVersion>
                <ignoreVersion>
                  <type>regex</type>
                  <version>(?i).*-m[0-9]+</version>
                </ignoreVersion>
                <!-- Vendor rebuilds. The separator is [-.], not just '-': the first run of
                     this ruleset still leaked 1.3.2 -> 1.3.2.redhat-00003, which a
                     hyphen-only pattern does not match. -->
                <ignoreVersion>
                  <type>regex</type>
                  <version>(?i).*[-.](jboss|redhat|atlassian|brew)[-.0-9]*</version>
                </ignoreVersion>
                <!-- Date/build-stamped pre-final builds, e.g. jaxb-api 2.4.0-b180830.0359 -->
                <ignoreVersion>
                  <type>regex</type>
                  <version>(?i).*-b[0-9]{6,}[-.0-9]*</version>
                </ignoreVersion>
              </ignoreVersions>
              <rules>
                <!-- me.friwi:jcef-api is PINNED and must never be auto-bumped. Its version
                     string is not semantic — "jcef-<hash>+cef-<v>+g<hash>+chromium-<v>" — so
                     Maven's version ordering is meaningless on it. The first clean run of this
                     ruleset proved the hazard: it proposed
                       cef-146.0.10+chromium-146.0.7680.179  ->  cef-132.3.1+chromium-132.0.6834.83
                     i.e. a DOWNGRADE, and specifically back below CEF 135, which crashes on
                     macOS 26. CEF 146 is the deliberate fix for that crash (see
                     fetch-thirdparty.sh:64-68, where the same tag is pinned for the natives —
                     the jar and the natives must stay in lockstep). Ignored entirely so the
                     report never recommends reintroducing a known crash. -->
                <rule>
                  <groupId>me.friwi</groupId>
                  <artifactId>jcef-api</artifactId>
                  <ignoreVersions>
                    <ignoreVersion>
                      <type>regex</type>
                      <version>.*</version>
                    </ignoreVersion>
                  </ignoreVersions>
                </rule>
              </rules>
            </ruleSet>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!-- Run JUnit 6 tests: surefire auto-detects the junit-platform provider from the
           launcher on the test classpath. Bound to the `test` phase as usual. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${maven-surefire-plugin.version}</version>
        <configuration>
          <!-- @{argLine} preserves the JaCoCo agent's argLine. java.library.path lets
               System.loadLibrary("scilab") find libscilab in the farm; DYLD_LIBRARY_PATH
               is set via surefire's ProcessBuilder fork (which macOS SIP does NOT strip,
               unlike the mvn shell wrapper), so it resolves libscilab's absolute-
               install-name siblings by leaf name from the same farm. Hermetic (non-native)
               tests ignore all of it. -->
          <argLine>@{argLine} -Djava.library.path=${scilab.test.native.libs}</argLine>
          <environmentVariables>
            <DYLD_LIBRARY_PATH>${scilab.test.native.libs}</DYLD_LIBRARY_PATH>
            <SCI>${scilab.test.sci.root}</SCI>
          </environmentVariables>
          <!-- The 40 MIGRATED legacy tests under org.scilab.tests.* are native
               INTEGRATION tests: they System.loadLibrary("scilab") / embed the engine
               (javasci). libscilab's siblings link via ABSOLUTE /usr/local/lib/scilab/
               install-names, and macOS SIP strips DYLD_LIBRARY_PATH from the forked test
               JVM, so they cannot resolve without a privileged one-time setup
               (sudo ln -sfn build-cmake/test-native-libs /usr/local/lib/scilab, or a
               cmake-install to that prefix). Excluded by default so `mvn test` stays green on any
               machine; run them with -Pnative-tests AFTER that setup. New hermetic unit
               tests live under org.scilab.modules.* and always run. -->
          <excludes>
            <exclude>**/org/scilab/tests/**</exclude>
          </excludes>
        </configuration>
      </plugin>
      <!-- Code coverage: the JaCoCo agent instruments the test JVM (prepare-agent), then
           writes the per-module HTML/XML/CSV report at the end of the test phase. A
           reactor-wide number comes from jacoco:report-aggregate in the coverage-report module. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco-maven-plugin.version}</version>
        <executions>
          <execution>
            <id>jacoco-prepare-agent</id>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>jacoco-report</id>
            <phase>test</phase>
            <goals><goal>report</goal></goals>
          </execution>
        </executions>
      </plugin>
      <!-- THIRD-PARTY STAGING. Maven resolves these from repositories; this execution copies
           the resolved jars into thirdparty/, which is what etc/classpath.xml, bin/scilab and
           package-macos.sh all read at runtime. That split is the whole point: dependencies
           become normal Maven dependencies (resolvable, updatable, visible to
           versions:display-dependency-updates) WITHOUT moving the runtime layout.

           Why `copy` with explicit artifactItems here, rather than `copy-dependencies` inherited
           by each module: copy-dependencies writes artifactId-version.jar, and 5 of our 28
           mappings do not match the filenames classpath.xml resolves by — javafx.base.jar,
           javafx.graphics.jar, javafx.swing.jar, jcef-api.jar and jhall-2.0.jar. A default-named
           copy would leave classpath.xml pointing at files that no longer exist, which fails at
           RUNTIME, not at build time. destFileName pins each one. Centralizing also keeps the
           list in one readable place instead of spread across 24 POMs.

           Only Tier A is listed so far — the 13 jars proven byte-identical to Maven Central by
           SHA-1 (docs/design/systempath-removal.md). Tiers B/C/D still come from
           fetch-thirdparty.sh and keep their systemPath entries; that file remains the source for
           natives and for anything Maven cannot supply. The two mechanisms coexist safely: both
           write the same filenames into the same directory. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.8.1</version>
        <executions>
          <execution>
            <id>stage-thirdparty-jars</id>
            <phase>generate-resources</phase>
            <goals><goal>copy</goal></goals>
            <inherited>false</inherited>
            <configuration>
              <outputDirectory>${project.basedir}/thirdparty</outputDirectory>
              <overWriteIfNewer>true</overWriteIfNewer>
              <artifactItems>
                <artifactItem><groupId>com.google.code.gson</groupId><artifactId>gson</artifactId><version>2.10.1</version><destFileName>gson-2.10.1.jar</destFileName></artifactItem>
                <artifactItem><groupId>net.java.dev.jna</groupId><artifactId>jna</artifactId><version>5.14.0</version><destFileName>jna-5.14.0.jar</destFileName></artifactItem>
                <artifactItem><groupId>org.apache.lucene</groupId><artifactId>lucene-core</artifactId><version>9.10.0</version><destFileName>lucene-core-9.10.0.jar</destFileName></artifactItem>
                <artifactItem><groupId>org.apache.lucene</groupId><artifactId>lucene-queryparser</artifactId><version>9.10.0</version><destFileName>lucene-queryparser-9.10.0.jar</destFileName></artifactItem>
                <artifactItem><groupId>org.apache.xmlgraphics</groupId><artifactId>batik-all</artifactId><version>1.17</version><destFileName>batik-all-1.17.jar</destFileName></artifactItem>
                <artifactItem><groupId>org.apache.xmlgraphics</groupId><artifactId>fop-core</artifactId><version>2.9</version><destFileName>fop-core-2.9.jar</destFileName></artifactItem>
                <artifactItem><groupId>org.apache.xmlgraphics</groupId><artifactId>xmlgraphics-commons</artifactId><version>2.9</version><destFileName>xmlgraphics-commons-2.9.jar</destFileName></artifactItem>
                <artifactItem><groupId>org.scilab.forge</groupId><artifactId>jlatexmath</artifactId><version>1.0.7</version><destFileName>jlatexmath-1.0.7.jar</destFileName></artifactItem>
                <artifactItem><groupId>org.scilab.forge</groupId><artifactId>jlatexmath-fop</artifactId><version>1.0.7</version><destFileName>jlatexmath-fop-1.0.7.jar</destFileName></artifactItem>
                <artifactItem><groupId>javax.xml.bind</groupId><artifactId>jaxb-api</artifactId><version>2.3.1</version><destFileName>jaxb-api-2.3.1.jar</destFileName></artifactItem>
                <artifactItem><groupId>jakarta.activation</groupId><artifactId>jakarta.activation-api</artifactId><version>2.1.3</version><destFileName>jakarta.activation-api-2.1.3.jar</destFileName></artifactItem>
                <artifactItem><groupId>javax.annotation</groupId><artifactId>javax.annotation-api</artifactId><version>1.3.2</version><destFileName>javax.annotation-api-1.3.2.jar</destFileName></artifactItem>
                <artifactItem><groupId>me.friwi</groupId><artifactId>jcef-api</artifactId><version>jcef-d3de827+cef-146.0.10+g8219561+chromium-146.0.7680.179</version><destFileName>jcef-api.jar</destFileName></artifactItem>
                <!-- JavaFX: classifier artifacts, renamed to the SDK filenames etc/classpath.xml
                     resolves by. Without destFileName these would land as javafx-base-25.0.2-
                     mac-aarch64.jar and the runtime would look for a file that is not there. -->
                <artifactItem><groupId>org.openjfx</groupId><artifactId>javafx-base</artifactId><version>25.0.2</version><classifier>${javafx.platform}</classifier><destFileName>javafx.base.jar</destFileName></artifactItem>
                <artifactItem><groupId>org.openjfx</groupId><artifactId>javafx-graphics</artifactId><version>25.0.2</version><classifier>${javafx.platform}</classifier><destFileName>javafx.graphics.jar</destFileName></artifactItem>
                <artifactItem><groupId>org.openjfx</groupId><artifactId>javafx-swing</artifactId><version>25.0.2</version><classifier>${javafx.platform}</classifier><destFileName>javafx.swing.jar</destFileName></artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.15.0</version>
        <configuration>
          <!-- build.incl.xml:129 source="25" target="25": reproduced as the
               classic source/target PAIR, deliberately NOT the unified
               <release> element task-2-brief.md Step 3 suggested. Tried
               <release>25</release> first: it fails outright with
               "exporting a package from system module java.base is not
               allowed with release", because javac's release mode compiles
               against a stripped per-release symbol table (ct.sym) that
               does not contain java.base's non-exported internal packages
               at all, so add-exports (below) has nothing to add-export TO.
               The source/target pair compiles directly against the CURRENT
               running JDK's real module system instead (no ct.sym
               involved), which is what actually allows add-exports and
               add-opens to work, and it is also the textually exact match
               for what Ant's javac task attribute pair (source="25"
               target="25", not a unified release="25") already does; Ant
               hits no such restriction, which is how this mismatch
               surfaced. See task-2-report.md Step 5 for the failing build
               output. -->
          <source>25</source>
          <target>25</target>
          <!-- The 40 migrated legacy tests (org.scilab.tests.*) are native INTEGRATION
               tests kept for the -Pnative-tests path (see the surefire comment). Some
               reference evolved engine APIs and all need the native runtime, so they are
               excluded from test-compilation here to keep `mvn package` green everywhere.
               New hermetic unit tests under org.scilab.modules.* compile and run normally. -->
          <testExcludes>
            <testExclude>**/org/scilab/tests/**</testExclude>
          </testExcludes>
          <!-- build.incl.xml:129 encoding="utf-8" -->
          <encoding>UTF-8</encoding>
          <!-- build.incl.xml:129 debug="${build.debug}"; scilab.properties:3
               sets build.debug=off, which makes Ant's javac task pass
               -g:none: NO debug info at all (no LineNumberTable /
               LocalVariableTable / SourceFile attributes). Maven's own
               default is debug=true. This is NOT cosmetic: the jars parity
               dimension (build-parity/parity/capture.py:fingerprint_jar)
               hashes each class entry's raw bytes, and -g:none vs the default
               produces DIFFERENT (and differently-SIZED) bytes for every
               single .class file — confirmed by an actual build, all 6
               .class files 87-144 bytes larger with debug=false ALONE than
               with the -g:none compilerArg below added (task-2-report.md
               Step 5). debuglevel="lines,vars,source" (build.incl.xml:129)
               only selects WHICH tables -g emits when debug=on — moot here
               since Ant's debug is off. -->
          <debug>false</debug>
          <!-- <debug>false</debug> ALONE IS NOT ENOUGH, confirmed by
               inspecting the actual javac command line Maven constructs
               (mvn ... -X): with only <debug>false</debug> set, Maven emits
               NO -g flag of any kind, which is not the same as -g:none:
               javac's OWN bare default (no -g flag at all) still generates
               LineNumberTable + SourceFile (per javac's docs: "If no flags
               are specified, javac generates line number and source file
               information"), which is BOTH what was observed (javap -v on
               the Maven-built .class files showed LineNumberTable/SourceFile
               present, byte counts larger than Ant's) and short of Ant's
               actual -g:none. The explicit -g:none compilerArg below is
               therefore the real, load-bearing fix; <debug>false</debug> is
               kept only so the intent reads correctly next to it, not
               because it does anything by itself here. -->
          <!-- build.incl.xml:129 deprecation="on" — a diagnostic-only
               warning switch (stderr output), never changes the compiled
               .class bytes. Reproduced for fidelity with Ant's javac
               invocation; the parity gate does not need it. -->
          <showDeprecation>true</showDeprecation>
          <compilerArgs>
            <!-- THE actual -g:none, load-bearing per the debug comments
                 above: this is what makes the compiled .class bytes match
                 Ant's. -->
            <arg>-g:none</arg>
            <!-- build.incl.xml:130-140 — the -Xlint family. Diagnostic-only
                 warning selection (stderr output), zero effect on emitted
                 bytecode or the manifest. Reproduced only so this POM is a
                 complete mirror of Ant's javac invocation, not because parity
                 needs any of them. -->
            <arg>-Xlint</arg>
            <arg>-Xlint:-unchecked</arg>
            <arg>-Xlint:-rawtypes</arg>
            <arg>-Xlint:-path</arg>
            <arg>-Xlint:-serial</arg>
            <arg>-Xlint:-options</arg>
            <!-- build.incl.xml:141-143 — LOAD-BEARING, not boilerplate.
                 modules/jvm/src/java/org/scilab/modules/jvm/LibraryPath.java:25-26
                 imports jdk.internal.loader.NativeLibraries and
                 sun.misc.Unsafe and reflectively rewrites
                 LibraryPaths.USER_PATHS; without these three flags that file
                 does not compile under JDK 17+ module encapsulation.
                 modules/localization (this beachhead's module) does not need
                 them — but Ant applies them to EVERY module's compile
                 unconditionally, because they live in the one shared
                 `compile` target every module's build.xml imports from this
                 file, not in a per-module override. The policy belongs here,
                 at the parent, for the same reason: every child module
                 inherits it automatically, matching Ant's actual shared-target
                 behavior, instead of each module POM re-declaring it only
                 where currently known to be needed and silently diverging
                 from Ant the day some other module needs it too. -->
            <arg>--add-exports=java.base/jdk.internal.loader=ALL-UNNAMED</arg>
            <arg>--add-opens=java.base/jdk.internal.loader=ALL-UNNAMED</arg>
            <arg>--add-opens=java.base/java.lang.reflect=ALL-UNNAMED</arg>
          </compilerArgs>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.5.0</version>
        <!-- Pins maven-jar-plugin's OWN bundled maven-archiver dependency down
             from 3.6.5 (this plugin version's default, per its own POM
             property mavenArchiverVersion) to 3.6.4. Confirmed by decompiling
             both: maven-archiver 3.6.5 added an UNCONDITIONAL new manifest
             main attribute, "Java-Version: <release/target>", with no
             configuration flag to turn it off (unlike the neighboring
             Build-Jdk-Spec, which DOES have one, addBuildEnvironmentEntries);
             3.6.4 and earlier do not add it at all. Confirmed by an actual
             build: with 3.6.5, the jar's manifest carried an extra
             "Java-Version: 25" line that is NOT one of the lines
             parity/fingerprint.py's _MANIFEST_VOLATILE regex strips (Ant-
             Version/Created-By/Built-By/Built-Date/Build-Jdk(-Spec)/Bnd-
             LastModified/Archiver-Version, plus the DSTAMP/TSTAMP-shaped
             Implementation-Version) — see task-2-report.md Step 5. Per this
             stage's binding constraint, extending that regex to also strip
             Java-Version is not an option (parity/fingerprint.py must not be
             touched; the POM is what's wrong, not the harness), and pinning
             a plugin's transitive dependency version via <dependencies> is a
             completely ordinary, first-class Maven mechanism, not a hack. -->
        <dependencies>
          <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-archiver</artifactId>
            <version>3.6.4</version>
          </dependency>
        </dependencies>
        <configuration>
          <archive>
            <!-- MANDATORY, not boilerplate. maven-jar-plugin embeds
                 META-INF/maven/<groupId>/<artifactId>/pom.xml and
                 pom.properties into every jar by default. Ant's jars have
                 none of that — it is a real divergence from the artifact
                 this beachhead reproduces, and
                 build-parity/tests/test_jar.py::test_maven_descriptor_entries_are_a_real_difference
                 (Task 1 of this stage, commit 3a32370905e) exists specifically
                 to lock the gate's strictness here: it fails the moment
                 anyone "fixes" a META-INF/maven mismatch by excluding that
                 path in the harness instead of turning this off in the POM.
                 Set once, at the parent, so every child jar gets it without
                 having to remember to repeat it. -->
            <addMavenDescriptor>false</addMavenDescriptor>
            <manifest>
              <!-- Ant's shared `jar` target (build.incl.xml:148-163) sets
                   exactly ONE main-section attribute itself (Built-By,
                   handled below via manifestEntries) and nothing else at the
                   top level — no Maven-style auto-populated
                   Specification-Title/Implementation-Title etc. at the MAIN
                   attribute level (those only exist per-package, inside each
                   module's own named manifest section — see e.g.
                   modules/localization/pom.xml's <manifestFile>). Both of
                   these default to false already; set explicitly so that
                   stays a documented decision instead of an accident of the
                   default. -->
              <addDefaultImplementationEntries>false</addDefaultImplementationEntries>
              <addDefaultSpecificationEntries>false</addDefaultSpecificationEntries>
            </manifest>
            <manifestEntries>
              <!-- build.incl.xml:151 <attribute name="Built-By" value="${user.name}"/>.
                   Reproduced for fidelity; parity-inert either way:
                   parity/fingerprint.py's _MANIFEST_VOLATILE strips any
                   Built-By line before the jars dimension compares manifests
                   (same treatment as Ant-Version/Created-By/etc., all of
                   which are build-environment specifics, not build output). -->
              <Built-By>${user.name}</Built-By>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
